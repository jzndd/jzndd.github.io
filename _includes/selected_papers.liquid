{% comment %}
  <div class="publications">
    {% bibliography --group_by none --query @*[selected=true]* %}
  </div>
{% endcomment %}

<div class="publications">
  <div class="publication-group-heading">
    <h3>Peer-reviewed &amp; Accepted</h3>
    <span>Published research</span>
  </div>
  {% bibliography --group_by none --sort_by year --order descending --query @*[selected=true && status=published]* %}

  <div class="publication-group-heading">
    <h3>Preprints &amp; Under Review</h3>
    <span>Latest work</span>
  </div>
  {% bibliography --group_by none --sort_by year --order descending --query @*[selected=true && status=preprint]* %}
</div>
